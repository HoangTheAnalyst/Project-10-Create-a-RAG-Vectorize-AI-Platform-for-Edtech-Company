# Stage: Base Python Environment
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies if required for Vector DB / C extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install dependencies first for caching
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy all contents from the backend folder (including app/) into /app
COPY . .

EXPOSE 8000

# Execute uvicorn pointing directly to main.py inside the app/ directory
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]